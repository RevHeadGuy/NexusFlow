# Copy to backend/.env for local development.
APP_NAME=NexusFlow
APP_ENV=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# For deployments, set a persistent random value (for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
AUTH_TOKEN_EXPIRE_MINUTES=720

# Local-only database and provider make the project usable without cloud credentials.
DATABASE_URL=sqlite:///./nexusflow.db
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Bedrock setup: use LLM_PROVIDER=bedrock and supply AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY to the backend process. Never commit access keys.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Browser origins allowed to call this local API.
CORS_ORIGINS=["http://localhost:3000"]

# Base URL of the frontend, used to build invitation links in emails.
FRONTEND_BASE_URL=http://localhost:3000

# Email (SMTP) delivery for project invitations. Disabled by default; invites
# still return a copyable link. Set EMAIL_ENABLED=true plus SMTP_HOST to send.
EMAIL_ENABLED=false
EMAIL_FROM=NexusFlow <no-reply@nexusflow.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Cross-process agent-to-agent (A2A) handoff. When enabled, each A2A message is
# also POSTed to this webhook in addition to the in-process bus. Disabled by
# default; the in-process bus is always the source of truth.
A2A_EXTERNAL_DELIVERY_ENABLED=false
A2A_WEBHOOK_URL=
A2A_WEBHOOK_TOKEN=
