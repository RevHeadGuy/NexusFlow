# Core app settings
APP_NAME=NexusFlow
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# API / backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusflow
# For local development without Postgres, the app may fall back to a SQLite database configuration.

# LLM provider
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-with-real-key
AWS_SECRET_ACCESS_KEY=replace-with-real-key
LLM_API_KEY=replace-with-real-key
LLM_TIMEOUT_SECONDS=60

# Optional integrations
REDIS_URL=redis://localhost:6379/0
```
